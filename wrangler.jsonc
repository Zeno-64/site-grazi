{
  // Deploy via Cloudflare Workers (static assets).
  // "directory" aponta para public/ e nao para a raiz de proposito:
  // com "." o wrangler subiria o proprio wrangler.jsonc e o .git junto.
  // Nao existe "main": sem codigo de Worker, os assets sao gratuitos
  // e ilimitados, e o limite de 100k req/dia nao se aplica.
  "name": "grazielecruz",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./public"
  }
}
